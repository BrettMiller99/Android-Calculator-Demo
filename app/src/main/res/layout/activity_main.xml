<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/display_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="24dp"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="72sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        app:layout_constraintBottom_toTopOf="@+id/buttons_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <GridLayout
        android:id="@+id/buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="16dp"
        android:rowCount="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/display_result">

        <!-- Row 1 -->
        <Button
            android:id="@+id/button_clear"
            style="@style/CalculatorFunctionButton"
            android:onClick="onClearClick"
            android:text="C" />

        <Button
            android:id="@+id/button_plus_minus"
            style="@style/CalculatorFunctionButton"
            android:onClick="onPlusMinusClick"
            android:text="+/-" />

        <Button
            android:id="@+id/button_percent"
            style="@style/CalculatorFunctionButton"
            android:onClick="onPercentClick"
            android:text="%" />

        <Button
            android:id="@+id/button_divide"
            style="@style/CalculatorOperationButton"
            android:onClick="onOperatorClick"
            android:text="÷" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/button_7"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="7" />

        <Button
            android:id="@+id/button_8"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="8" />

        <Button
            android:id="@+id/button_9"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="9" />

        <Button
            android:id="@+id/button_multiply"
            style="@style/CalculatorOperationButton"
            android:onClick="onOperatorClick"
            android:text="×" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/button_4"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="4" />

        <Button
            android:id="@+id/button_5"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="5" />

        <Button
            android:id="@+id/button_6"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="6" />

        <Button
            android:id="@+id/button_subtract"
            style="@style/CalculatorOperationButton"
            android:onClick="onOperatorClick"
            android:text="-" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/button_1"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="1" />

        <Button
            android:id="@+id/button_2"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="2" />

        <Button
            android:id="@+id/button_3"
            style="@style/CalculatorNumberButton"
            android:onClick="onNumberClick"
            android:text="3" />

        <Button
            android:id="@+id/button_add"
            style="@style/CalculatorOperationButton"
            android:onClick="onOperatorClick"
            android:text="+" />

        <!-- Row 5 -->
        <Button
            android:id="@+id/button_0"
            android:layout_width="176dp"
            android:layout_height="80dp"
            android:layout_columnSpan="2"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="8dp"
            android:background="@drawable/button_zero_background"
            android:onClick="onNumberClick"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/button_decimal"
            style="@style/CalculatorNumberButton"
            android:onClick="onDecimalClick"
            android:text="." />

        <Button
            android:id="@+id/button_equals"
            style="@style/CalculatorOperationButton"
            android:onClick="onEqualsClick"
            android:text="=" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
